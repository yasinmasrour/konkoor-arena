generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id   String @id @default(cuid())
  name String @unique

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id String @id @default(cuid())

  firstName String
  lastName  String

  email    String @unique
  password String

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  subscriptions Subscription[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions Question[]

  booklets Booklet[]

  exams Exam[]

  attempts Attempt[]

  arenaMatchPlayers ArenaMatchPlayer[]

  arenaQueues ArenaQueue[]

  arenaRatings ArenaRating[]

  arenaRatingHistory ArenaRatingHistory[]

  arenaLeagueStandings ArenaLeagueStanding[]

  aiAnalyses AIAnalysis[]
  questionReviews QuestionReview[] @relation("QuestionReviewReviewer")
}

model SubscriptionPlan {
  id String @id @default(cuid())

  title       String
  description String?

  price        Int
  durationDays Int

  subscriptions Subscription[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id String @id @default(cuid())

  userId String
  planId String

  user User             @relation(fields: [userId], references: [id])
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  startDate DateTime
  endDate   DateTime

  status String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id String @id @default(cuid())

  userId String
  planId String

  user User @relation(fields: [userId], references: [id])
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  amount Int
  status String
  gateway String
  merchantOrderId String @unique
  authority String? @unique
  transactionId String? @unique
  paidAt DateTime?
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([userId, status])
}

model Question {
  id String @id @default(uuid())

  code String @unique

  lesson String

  grade String

  major String

  chapter String

  topic String @default("")

  questionText String

  questionImage String @default("")

  options String[]

  correctAnswer Int

  explanation String @default("")

  explanationPdf String @default("")

  source String @default("")

  author String @default("")

  year Int?

  difficulty String @default("medium")

  tags String[] @default([])

  usageCount Int @default(0)

  status String @default("draft")

  createdById String

  createdBy User @relation(fields: [createdById], references: [id])

  bookletQuestions BookletQuestion[]

  attemptAnswers AttemptAnswer[]

  reviews QuestionReview[]

  arenaMatchQuestions ArenaMatchQuestion[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([lesson])
  @@index([grade])
  @@index([major])
  @@index([difficulty])
}


model QuestionReview {
  id String @id @default(cuid())

  questionId String
  reviewerId String

  decision String
  note String @default("")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reviewer User @relation("QuestionReviewReviewer", fields: [reviewerId], references: [id])

  createdAt DateTime @default(now())

  @@index([questionId, createdAt])
  @@index([reviewerId, createdAt])
  @@index([decision, createdAt])
}

model Booklet {
  id String @id @default(cuid())

  title String @default("")

  lesson String

  grade String

  major String

  examDate DateTime

  duration Int

  questions BookletQuestion[]

  status String @default("draft")

  createdById String

  createdBy User @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  examBooklets ExamBooklet[]
}

model BookletQuestion {
  id String @id @default(cuid())

  bookletId String

  questionId String

  booklet Booklet @relation(fields: [bookletId], references: [id])

  question Question @relation(fields: [questionId], references: [id])

  order Int

  score Float @default(1)

  createdAt DateTime @default(now())

  @@unique([bookletId, questionId])
}

model Exam {
  id String @id @default(cuid())

  title String

  examDate DateTime

  startTime String

  endTime String @default("")

  booklets ExamBooklet[]

  attempts Attempt[]

  status String @default("draft")

  createdById String

  createdBy User @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model ExamBooklet {
  id String @id @default(cuid())

  examId String

  bookletId String

  exam Exam @relation(fields: [examId], references: [id])

  booklet Booklet @relation(fields: [bookletId], references: [id])

  order Int

  createdAt DateTime @default(now())

  @@unique([examId, bookletId])
}

model Attempt {
  id String @id @default(cuid())

  studentId String

  examId String

  student User @relation(fields: [studentId], references: [id])

  exam Exam @relation(fields: [examId], references: [id])

  answers AttemptAnswer[]

  startedAt DateTime?

  submittedAt DateTime?

  status String @default("started")

  score Float @default(0)

  analysis Json @default("{}")

  aiAnalysis AIAnalysis?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([studentId, examId])
  @@index([studentId])
  @@index([examId])
  @@index([studentId, status])
}

model AIAnalysis {
  id String @id @default(cuid())

  attemptId String @unique
  userId String

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  model String
  status String
  result Json
  responseId String? @unique
  generatedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

model AttemptAnswer {
  id String @id @default(cuid())

  attemptId String

  questionId String

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  question Question @relation(fields: [questionId], references: [id])

  selectedAnswer Int?

  // Immutable question data captured when the attempt starts.
  questionTextSnapshot String?
  questionImageSnapshot String?
  optionsSnapshot String[] @default([])
  correctAnswerSnapshot Int?
  explanationSnapshot String?
  difficultySnapshot String?
  lessonSnapshot String?
  chapterSnapshot String?
  scoreSnapshot Float @default(1)

  isCorrect Boolean @default(false)

  answeredAt DateTime?

  createdAt DateTime @default(now())

  @@unique([attemptId, questionId])
  @@index([attemptId, selectedAnswer])
}

model ArenaMatch {
  id String @id @default(cuid())

  leagueId String

  status String @default("waiting")

  winnerId String?

  startedAt  DateTime?
  finishedAt DateTime?

  league ArenaLeague @relation(fields: [leagueId], references: [id])

  ratingHistory ArenaRatingHistory[]

  ratingUpdatedAt DateTime?

  ratingUpdated Boolean @default(false)

  players   ArenaMatchPlayer[]
  questions ArenaMatchQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArenaMatchPlayer {
  id String @id @default(cuid())

  matchId String
  userId  String

  match ArenaMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id])

  lives Int @default(3)

  status String @default("playing")

  isWinner Boolean @default(false)

  joinedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, userId])
  @@index([userId])
  @@index([matchId])
}

model ArenaMatchQuestion {
  id String @id @default(cuid())

  matchId    String
  questionId String

  match    ArenaMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  question Question   @relation(fields: [questionId], references: [id])

  order     Int
  timeLimit Int

  status String @default("pending")

  startedAt  DateTime?
  finishedAt DateTime?

  winnerId String?

  answers ArenaAnswer[]

  createdAt DateTime @default(now())

  @@unique([matchId, questionId])
  @@unique([matchId, order])
  @@index([questionId])
}

model ArenaLeague {
  id String @id @default(cuid())

  title String

  lesson String

  startDate DateTime
  endDate   DateTime

  status String @default("upcoming")

  matches ArenaMatch[]

  queues ArenaQueue[]

  ratings ArenaRating[]

  ratingHistory ArenaRatingHistory[]

  standings ArenaLeagueStanding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArenaAnswer {
  id String @id @default(cuid())

  matchQuestionId String
  playerId        String

  selectedAnswer Int?

  isCorrect Boolean

  answeredAt DateTime @default(now())

  responseTimeMs Int?

  matchQuestion ArenaMatchQuestion @relation(fields: [matchQuestionId], references: [id], onDelete: Cascade)

  @@unique([matchQuestionId, playerId])
  @@index([playerId])
  @@index([matchQuestionId])
}

model ArenaRating {
  id String @id @default(cuid())

  leagueId String
  userId   String

  rating Int @default(0)

  matchesPlayed Int @default(0)

  wins   Int @default(0)
  losses Int @default(0)
  draws  Int @default(0)

  league ArenaLeague @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leagueId, userId])
  @@index([leagueId, rating])
  @@index([userId])
}

model ArenaRatingHistory {
  id String @id @default(cuid())

  leagueId String
  userId   String
  matchId  String

  oldRating Int
  newRating Int

  change Int

  createdAt DateTime @default(now())

  league ArenaLeague @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  match  ArenaMatch  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([leagueId, userId])
  @@index([matchId])
}

model ArenaLeagueStanding {
  id String @id @default(cuid())

  leagueId String
  userId   String

  finalRating Int

  rank Int

  wins   Int
  losses Int
  draws  Int

  league ArenaLeague @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([leagueId, userId])
  @@index([leagueId, rank])
}

model ArenaQueue {
  id String @id @default(cuid())

  userId String
  leagueId String

  rating Int

  status String @default("waiting")

  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  league ArenaLeague @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([userId, leagueId])
  @@index([leagueId, status, rating])
  @@index([userId, status])
}
